# syntax=docker/dockerfile:1
FROM oven/bun:1.3.5 AS builder
WORKDIR /app

# Copy root monorepo manifests and workspaces
COPY package.json bun.lock bunfig.toml ./
COPY packages/i18n ./packages/i18n
COPY packages/observability ./packages/observability
COPY packages/collaboration ./packages/collaboration
COPY packages/loro-mirror ./packages/loro-mirror
COPY packages/lexical-core ./packages/lexical-core
COPY apps/web ./apps/web
COPY services/ai-editing-worker ./services/ai-editing-worker
COPY services/bots ./services/bots
COPY services/lexical-service ./services/lexical-service
COPY crates/agent_harness/sandbox_sizes.json ./crates/agent_harness/sandbox_sizes.json

# Install dependencies and build web frontend
RUN bun install --frozen-lockfile || bun install
WORKDIR /app/apps/web
RUN bun run build

# Production minimal runtime stage with Nginx
FROM nginx:alpine AS runner

# Copy customized Nginx SPA configuration
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static distribution into /usr/share/nginx/html/app and link root index
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html/app
RUN ln -s /usr/share/nginx/html/app/index.html /usr/share/nginx/html/index.html

# Inject runtime environment generator hook (reads MACRO_ADMIN_EMAIL / MACRO_ADMIN_PASSWORD)
RUN printf '%s\n' \
  '#!/bin/sh' \
  'set -e' \
  'ADMIN_EMAIL="${MACRO_ADMIN_EMAIL:-}"' \
  'ADMIN_PASS="${MACRO_ADMIN_PASSWORD:-}"' \
  'PASS_HASH=""' \
  'if [ -n "$ADMIN_PASS" ]; then' \
  '  PASS_HASH=$(printf "%s" "$ADMIN_PASS" | sha256sum | awk "{print \$1}")' \
  'elif [ -n "$MACRO_ADMIN_PASSWORD_HASH" ]; then' \
  '  PASS_HASH="$MACRO_ADMIN_PASSWORD_HASH"' \
  'fi' \
  'cat <<EOF > /usr/share/nginx/html/app/env-config.js' \
  'window.__MACRO_ENV__ = {' \
  '  ADMIN_EMAIL: "${ADMIN_EMAIL}",' \
  '  ADMIN_PASSWORD_HASH: "${PASS_HASH}"' \
  '};' \
  'EOF' \
  'chmod 644 /usr/share/nginx/html/app/env-config.js' \
  > /docker-entrypoint.d/40-generate-env.sh && \
  chmod +x /docker-entrypoint.d/40-generate-env.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
